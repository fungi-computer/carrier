{
  "name": "@fungi.computer/carrier",
  "version": "0.2.7",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Durable email submission and recipient delivery tracking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./inspection": {
      "types": "./dist/inspection.d.ts",
      "import": "./dist/inspection.js"
    },
    "./post": {
      "types": "./dist/post.d.ts",
      "import": "./dist/post.js"
    },
    "./post-d1": {
      "types": "./dist/post-d1.d.ts",
      "import": "./dist/post-d1.js"
    },
    "./post-postgres": {
      "types": "./dist/post-postgres.d.ts",
      "import": "./dist/post-postgres.js"
    }
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "smoke": "node --input-type=module -e \"Promise.all([import('./dist/index.js'), import('./dist/cloudflare.js'), import('./dist/inspection.js')]).then(() => {})\""
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@fungi.computer/almanac": "0.2.1",
    "@fungi.computer/cairn": "0.1.0",
    "@fungi.computer/watchdog": "0.1.6",
    "effect": "4.0.2",
    "pg": "8.23.0",
    "@types/pg": "8.23.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/carrier.git"
  }
}
